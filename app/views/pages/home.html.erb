<% content_for :title, t("app.name") %>

<div class="text-center space-y-8 py-12">
  <h1 class="text-4xl sm:text-5xl font-extrabold text-rose-600"><%= t("app.name") %></h1>
  <p class="text-slate-600"><%= t("app.tagline") %></p>
  <div class="space-y-3 max-w-sm mx-auto">
    <%= link_to t("pages.home.create"), games_path, data: { turbo_method: :post }, class: "block w-full rounded-lg bg-rose-600 hover:bg-rose-700 active:bg-rose-800 text-white text-lg font-semibold py-4 px-6 transition-colors shadow-sm" %>
    <%= link_to t("pages.home.enter"), enter_path, class: "block w-full rounded-lg border border-rose-300 bg-white hover:bg-rose-50 text-rose-700 text-lg font-semibold py-4 px-6 transition-colors" %>
  </div>
</div>
