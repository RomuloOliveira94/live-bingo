<% content_for :title, t("app.name") %>

<div class="py-12 flex flex-col items-center gap-7">
  <div class="text-center max-w-md space-y-2">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">Crie uma sala de bingo</h1>
    <p class="text-bingo-muted text-sm sm:text-base leading-relaxed">Crie uma partida e receba um código para compartilhar — ou entre em uma sala existente.</p>
  </div>
  <div class="w-full max-w-sm flex flex-col sm:flex-row gap-3">
    <%= button_to t("pages.home.create"), games_path, method: :post, class: "flex-1 py-4 bg-bingo-red text-bingo-on-red rounded-2xl font-bold text-base hover:brightness-90" %>
    <%= link_to t("pages.home.enter"), enter_path, class: "flex-1 py-4 border-[1.5px] border-bingo-line rounded-2xl font-medium text-center hover:border-bingo-fg" %>
  </div>
</div>
