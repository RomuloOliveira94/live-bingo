<%# Home's own descriptive <title> (distinct from the app name, which the
    layout already appends after " · " — see SeoHelper#page_title). Reuses
    the existing tagline rather than a new key: it's the same "what is this"
    one-liner already shown in the PWA manifest. %>
<% content_for :title, t("app.tagline") %>

<div class="pt-11 px-7 pb-12 flex flex-col items-center gap-7">
  <div class="text-center max-w-[460px] flex flex-col gap-2.5">
    <h1 class="font-display font-bold text-[34px] leading-[1.05] tracking-[-0.02em] text-balance m-0">
      <%= t("pages.home.heading_line1") %><br><%= t("pages.home.heading_line2") %>
    </h1>
    <p class="font-body text-[15px] leading-relaxed text-bingo-muted text-pretty m-0"><%= t("pages.home.subtitle") %></p>
  </div>
  <div class="w-full max-w-[400px] flex flex-wrap gap-2.5">
    <%= button_to t("pages.home.create"), games_path, method: :post, class: "flex-[1_1_180px] #{btn_primary_classes}" %>
    <%= link_to t("pages.home.enter"), enter_path, class: "flex-[1_1_140px] text-center #{btn_secondary_outline_classes}" %>
  </div>
</div>
