<% content_for :title, t("pages.enter.title") %>

<div class="py-12 max-w-sm mx-auto space-y-7">
  <div class="text-center space-y-2">
    <h1 class="text-3xl font-bold tracking-tight">Entrar em um bingo</h1>
    <p class="text-bingo-muted text-sm">Digite o código que o organizador compartilhou com você.</p>
  </div>
  <%= form_with url: enter_path, method: :post, local: true, class: "space-y-3" do |f| %>
    <label for="code" class="block text-xs uppercase tracking-widest text-bingo-muted">Código do bingo</label>
    <%= f.text_field :code, required: true, autofocus: true, id: :code,
        class: "w-full px-4 py-5 text-center text-3xl tracking-[0.18em] uppercase font-bold bg-bingo-surface border-[1.5px] border-bingo-line rounded-2xl outline-none focus:border-bingo-fg",
        maxlength: 7, inputmode: "text", autocomplete: "off" %>
    <% if flash[:alert] %>
      <p class="text-sm text-bingo-muted"><%= flash[:alert] %></p>
    <% end %>
    <%= f.submit t("pages.enter.submit"), class: "w-full py-4 bg-bingo-red text-bingo-on-red rounded-2xl font-bold text-base hover:brightness-90 cursor-pointer" %>
    <%= link_to "Quero criar um bingo", root_path, class: "block text-center text-sm text-bingo-muted py-3" %>
  <% end %>
</div>
