<% content_for :title, t("pages.enter.title") %>

<div class="max-w-sm mx-auto py-12 space-y-6">
  <h1 class="text-2xl font-bold text-center"><%= t("pages.enter.title") %></h1>
  <%= form_with url: enter_path, method: :post, local: true, class: "space-y-3" do |f| %>
    <div>
      <%= f.label :code, t("pages.enter.code_label"), class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_field :code, required: true, autofocus: true, class: "w-full rounded-lg border border-slate-300 px-4 py-3 text-center text-2xl font-mono uppercase tracking-widest focus:border-rose-500 focus:ring-2 focus:ring-rose-500 focus:outline-none", maxlength: 6, inputmode: "text", autocomplete: "off" %>
    </div>
    <%= f.submit t("pages.enter.submit"), class: "w-full rounded-lg bg-rose-600 hover:bg-rose-700 active:bg-rose-800 text-white text-lg font-semibold py-4 px-6 transition-colors cursor-pointer shadow-sm" %>
  <% end %>
</div>
