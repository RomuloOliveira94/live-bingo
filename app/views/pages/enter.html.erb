<% content_for :title, t("pages.enter.title") %>
<% content_for :description, t("seo.enter_description") %>

<div class="pt-11 px-7 pb-12 flex flex-col items-center gap-7">
  <div class="text-center max-w-[440px] flex flex-col gap-2.5">
    <h1 class="font-display font-bold text-[34px] leading-[1.05] tracking-[-0.02em] m-0">
      <%= t("pages.enter.heading_line1") %><br><%= t("pages.enter.heading_line2") %>
    </h1>
    <p class="font-body text-[15px] leading-relaxed text-bingo-muted text-pretty m-0"><%= t("pages.enter.subtitle") %></p>
  </div>

  <%= form_with url: enter_path, method: :post, local: true, class: "w-full max-w-[400px] flex flex-col gap-3" do |f| %>
    <%= f.label :code, t("pages.enter.code_label"), class: "font-display text-xs uppercase tracking-[0.1em] text-bingo-muted" %>
    <%= f.text_field :code, required: true, autofocus: true, id: :code,
        placeholder: t("pages.enter.code_placeholder"),
        class: "w-full box-border py-[18px] text-center font-display text-[30px] tracking-[0.18em] uppercase text-bingo-fg bg-bingo-surface border-[1.5px] border-bingo-line rounded-[14px] outline-none focus:border-bingo-fg",
        maxlength: 7, inputmode: "text", autocomplete: "off" %>
    <p class="text-[13px] text-center text-bingo-fg font-body m-0 <%= flash[:alert].present? ? "" : "invisible" %>">
      <%= flash[:alert].presence || t("pages.enter.code_invalid") %>
    </p>
    <%= f.submit t("pages.enter.submit"), class: "w-full #{btn_primary_classes}" %>
    <%= link_to t("pages.enter.create_instead"), root_path, class: "block text-center #{btn_ghost_classes}" %>
  <% end %>
</div>
