<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) ? "#{yield(:title)} · #{t('app.name')}" : t('app.name') %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta charset="utf-8">

    <%# PWA %>
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t('app.name') %>">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#e11d48">
    <meta name="apple-mobile-web-app-title" content="<%= t('app.name') %>">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>

    <%= yield :head %>

    <%# Favicon + ícones %>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.json">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <% if notice.present? %>
      <div class="mx-auto max-w-3xl px-4 pt-4" role="status" aria-live="polite">
        <div class="rounded-lg bg-emerald-50 border border-emerald-200 px-4 py-3 text-emerald-800 text-sm sm:text-base">
          <%= notice %>
        </div>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="mx-auto max-w-3xl px-4 pt-4" role="alert" aria-live="assertive">
        <div class="rounded-lg bg-rose-50 border border-rose-200 px-4 py-3 text-rose-800 text-sm sm:text-base">
          <%= alert %>
        </div>
      </div>
    <% end %>

    <main class="max-w-3xl mx-auto px-4 py-6">
      <%= yield %>
    </main>
  </body>
</html>
