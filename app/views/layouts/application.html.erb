<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) ? "#{yield(:title)} · #{t('app.name')}" : t('app.name') %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta charset="utf-8">

    <%# PWA %>
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t('app.name') %>">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#141414">
    <meta name="apple-mobile-web-app-title" content="<%= t('app.name') %>">

    <%# Fonts: Jost (Futura fallback) %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&display=swap" rel="stylesheet">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>

    <%= yield :head %>

    <%# Favicon + ícones %>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.json">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-bingo-bg text-bingo-fg antialiased">
    <% if notice.present? %>
      <div class="mx-auto max-w-3xl px-4 pt-4" role="status" aria-live="polite">
        <div class="rounded-lg bg-bingo-surface border border-bingo-line px-4 py-3 text-bingo-fg text-sm sm:text-base">
          <%= notice %>
        </div>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="mx-auto max-w-3xl px-4 pt-4" role="alert" aria-live="assertive">
        <div class="rounded-lg bg-bingo-surface border border-bingo-line px-4 py-3 text-bingo-fg text-sm sm:text-base">
          <%= alert %>
        </div>
      </div>
    <% end %>

    <main class="max-w-3xl mx-auto px-4 py-6">
      <%= yield %>
    </main>
  </body>
</html>
