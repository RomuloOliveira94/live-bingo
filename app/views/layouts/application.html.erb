<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) ? "#{yield(:title)} · #{t('app.name')}" : t('app.name') %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta charset="utf-8">

    <%# PWA %>
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t('app.name') %>">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#141414">
    <meta name="apple-mobile-web-app-title" content="<%= t('app.name') %>">

    <%# Full-page Turbo Drive visits morph in place instead of a hard replace,
        and keep scroll position — required so a broadcasted <turbo-stream
        action="refresh"> updates every connected client's DOM in place. %>
    <%= turbo_refresh_method_tag :morph %>
    <%= turbo_refresh_scroll_tag :preserve %>

    <%# Fonts: Jost (display) + DM Sans (body). Futura is referenced by the
        design but never actually loaded, so Jost is the real display font. %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Jost:wght@400;500;700&display=swap" rel="stylesheet">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>

    <%= yield :head %>

    <%# Favicon + ícones %>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.json">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-bingo-bg text-bingo-fg antialiased">
    <%= render "layouts/navbar" %>

    <div id="flash">
      <%= render "layouts/flash", notice: notice, alert: alert %>
    </div>

    <%# Empty slot a finished game's broadcast appends a redirect element into. %>
    <div id="redirect-slot"></div>

    <%# Rendered once per visitor, in THEIR OWN resolved locale (see
      ApplicationController#set_locale) — redirect_controller.js clones this
      into #flash when GamesController#finish's broadcast arrives, instead
      of trusting locale-sensitive text pushed over Action Cable. That
      broadcast is rendered inside the ACTING HOST's own I18n.with_locale
      and delivered byte-for-byte to every subscriber, so any translated
      text baked into it would only ever be correct for that one host — see
      GamesController#broadcast_finished_notice. %>
    <template id="finished-notice-template">
      <%= render "layouts/flash", notice: t("games.show.finished.message"), alert: nil %>
    </template>

    <main class="<%= shared_container_class %> pt-7 pb-14">
      <%= yield %>
    </main>
  </body>
</html>
