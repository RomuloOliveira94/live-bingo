<%#
  App-wide navbar. Not sticky — it scrolls with the page. Left: real logo +
  wordmark. Right: contextual step label set by each page via
  `content_for :step_label`.
%>
<header class="border-b border-bingo-line bg-bingo-surface">
  <div class="<%= shared_container_class %> py-4 flex items-center justify-between">
    <%= link_to root_path, class: "flex items-center gap-2.5" do %>
      <%= image_tag "logo.svg", alt: t("app.name"), class: "h-[26px] w-[26px] shrink-0" %>
      <span class="font-display font-bold text-[15px] tracking-[0.02em]"><%= t("app.wordmark") %></span>
    <% end %>
    <span class="font-display text-xs uppercase tracking-[0.08em] text-bingo-muted">
      <%= yield(:step_label) %>
    </span>
  </div>
</header>
