  Live), so this keeps the existing messaging restyled to match the rest of
  the app.
%>
<div class="flex flex-col items-center gap-3 text-center py-10">
  <p class="font-body text-[15px] leading-relaxed text-bingo-muted m-0"><%= t("games.show.waiting.visitor_message") %></p>
</div>
