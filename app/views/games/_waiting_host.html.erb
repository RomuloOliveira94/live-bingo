<div class="py-10 flex flex-col items-center gap-7">
  <div class="text-center space-y-1">
    <span class="text-xs uppercase tracking-widest text-bingo-muted">Sala criada</span>
    <h1 class="text-3xl font-bold tracking-tight">Chame a galera</h1>
    <div class="flex items-center justify-center gap-2 mt-2 text-sm text-bingo-muted">
      <span class="inline-block w-2 h-2 rounded-full bg-bingo-red animate-live-pulse"></span>
      <strong class="text-bingo-fg font-bold"><%= @game.viewer_count %></strong>
      <span><%= t("games.show.waiting.players_label", count: @game.viewer_count) %></span>
    </div>
  </div>

  <div class="w-full max-w-sm border-[1.5px] border-dashed border-bingo-red bg-bingo-red-soft rounded-[18px] p-7 flex flex-col items-center gap-4">
    <span class="text-xs uppercase tracking-widest text-bingo-muted">Código de acesso</span>
    <div id="game-code" class="text-[42px] font-bold tracking-[0.16em] text-bingo-red select-all" data-clipboard-text="<%= game.code %>">
      <%= format_game_code(game.code) %>
    </div>
    <div class="flex flex-wrap justify-center gap-2">
      <%= render "games/share", game: game %>
    </div>
  </div>

  <div class="w-full max-w-sm space-y-2">
    <%= button_to t("games.show.waiting.start_button"), start_game_path(code: game.code), method: :post,
        class: "w-full py-4 bg-bingo-red text-bingo-on-red rounded-2xl font-bold text-base hover:brightness-90" %>
    <p class="text-center text-xs text-bingo-muted"><%= t("games.show.waiting.players_label", count: game.viewer_count) %></p>
  </div>
</div>
