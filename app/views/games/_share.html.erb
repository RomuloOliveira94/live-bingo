<%# Renders the "copy code" + "share invite" pill buttons for the Share screen.
  Locals:
    game - Game instance
%>
<% share_url = game_url_for_sharing(game) %>
<div class="flex flex-wrap justify-center gap-2">
  <div data-controller="clipboard"
       data-clipboard-text-value="<%= game.code %>"
       data-clipboard-prompt-value="<%= t("helpers.clipboard.prompt") %>">
    <button type="button" data-clipboard-target="button" data-action="clipboard#copy" data-state="idle"
            class="group <%= btn_pill_outline_classes %>">
      <span class="group-data-[state=copied]:hidden"><%= t("games.show.share.copy_code") %></span>
      <span class="hidden group-data-[state=copied]:inline"><%= t("games.show.share.copy_code_done") %></span>
    </button>
  </div>

  <div data-controller="share"
       data-share-title-value="<%= t("games.show.share.payload_title") %>"
       data-share-text-value="<%= t("games.show.share.payload_body", code: game.code) %>"
       data-share-url-value="<%= share_url %>"
       data-share-prompt-value="<%= t("helpers.share.prompt") %>">
    <button type="button" data-share-target="button" data-action="share#share" data-state="idle"
            class="group <%= btn_pill_solid_icon_classes %>">
      <%= render "games/share_icon" %>
      <span class="group-data-[state=copied]:hidden">
        <span class="sm:hidden"><%= t("games.show.share.share_invite_mobile") %></span>
        <span class="hidden sm:inline"><%= t("games.show.share.share_invite_desktop") %></span>
      </span>
      <span class="hidden group-data-[state=copied]:inline"><%= t("games.show.share.copy_code_done") %></span>
    </button>
  </div>
</div>
