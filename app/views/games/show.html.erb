<% content_for :title, t("games.show.title") %>

<%= turbo_stream_from @game %>

<div class="space-y-6">
  <%# Header %>
  <header class="flex items-center justify-between gap-3">
    <div class="min-w-0">
      <p class="text-xs sm:text-sm text-slate-500">
        <span class="font-mono font-bold tracking-widest"><%= format_game_code(@game.code) %></span>
        <span id="game-status" class="ml-2"><%= render "games/status_badge", game: @game %></span>
      </p>
    </div>
    <% if is_host_of?(@game) && !@game.finished? %>
      <%= button_to t("games.show.finish_button"), finish_game_path(code: @game.code), method: :post,
            class: "rounded-lg border border-rose-300 bg-white hover:bg-rose-50 text-rose-700 text-sm font-medium px-3 py-2 transition-colors",
            data: { turbo_confirm: t("games.show.confirm_finish") } %>
    <% end %>
  </header>

  <%# Viewer count (everyone sees) %>
  <div id="viewer-count" class="text-center text-sm text-slate-500">
    <%= render "games/viewer_count", game: @game %>
  </div>

  <%# Waiting room (host) %>
  <% if @game.waiting? && is_host_of?(@game) %>
    <%= render "games/waiting_host", game: @game %>
  <% end %>

  <%# Waiting (non-host) %>
  <% if @game.waiting? && !is_host_of?(@game) %>
    <div class="text-center space-y-4 py-8">
      <p class="text-slate-600"><%= t("games.show.waiting.visitor_message") %></p>
    </div>
  <% end %>

  <%# Active or finished %>
  <% if @game.active? || @game.finished? %>
    <% last_draw = @game.draws.order(position: :desc).first %>
    <div id="last-ball" class="text-center">
      <%= render "games/last_ball", draw: last_draw %>
    </div>

    <div id="draw-history">
      <%= render "games/draw_history", draws: @game.draws.order(position: :desc) %>
    </div>

    <div id="drawn-count" class="text-center text-sm text-slate-500">
      <%= render "games/drawn_count", game: @game %>
    </div>

    <%# Host controls (active only) %>
    <% if @game.active? && is_host_of?(@game) %>
      <div class="space-y-3">
        <%= button_to t("games.show.active.draw_button"), draw_game_path(code: @game.code), method: :post,
              class: "w-full rounded-lg bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white text-lg font-semibold py-4 px-6 transition-colors shadow-sm" %>
        <%= button_to t("games.show.active.restart_button"), restart_game_path(code: @game.code), method: :post,
              class: "w-full rounded-lg bg-amber-600 hover:bg-amber-700 active:bg-amber-800 text-white text-lg font-semibold py-4 px-6 transition-colors shadow-sm",
              data: { turbo_confirm: t("games.show.confirm_restart") } %>
      </div>
    <% end %>
  <% end %>

  <%# Finished (viewer sees end) %>
  <% if @game.finished? && !is_host_of?(@game) %>
    <p class="text-center text-slate-600"><%= t("games.show.finished.message") %></p>
  <% end %>

  <%# Finished (host sees end) %>
  <% if @game.finished? && is_host_of?(@game) %>
    <div class="text-center space-y-4">
      <p class="text-slate-600"><%= t("games.show.finished.message") %></p>
      <%= link_to t("pages.home.create"), root_path, class: "inline-block rounded-lg bg-rose-600 hover:bg-rose-700 text-white font-semibold px-6 py-3 transition-colors" %>
    </div>
  <% end %>
</div>
