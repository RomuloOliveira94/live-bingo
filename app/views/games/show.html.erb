<% content_for :title, t("games.show.title") %>

<%= turbo_stream_from @game %>

<div class="flex flex-col gap-6 <%= @game.waiting? ? "pt-11 px-7 pb-12" : "p-[26px]" %>"
     data-controller="game-channel" data-game-channel-code-value="<%= @game.code %>">

  <%# Waiting — Share screen (host and guest, see games/_waiting) %>
  <% if @game.waiting? %>
    <%= render "games/waiting", game: @game %>
  <% end %>

  <%# Active / Finished — Live screen %>
  <% if @game.active? || @game.finished? %>
    <div class="flex flex-wrap gap-[26px] items-start">

      <%# LEFT: status line, cage/ball, draw button, recent history %>
      <div class="flex-[1_1_300px] min-w-[280px] flex flex-col items-center gap-5"
           data-controller="spin" data-action="turbo:submit-start->spin#start turbo:submit-end->spin#stop">
        <div class="flex items-center gap-2 font-display text-xs uppercase tracking-[0.1em] text-bingo-muted">
          <span class="w-[7px] h-[7px] rounded-full bg-bingo-accent inline-block" aria-hidden="true"></span>
          <%= t("games.show.active.status_line", code: format_game_code(@game.code)) %>
        </div>

        <div id="last-ball" data-controller="draw-sound" data-action="bingo:spin-start@window->draw-sound#play">
          <%= render "games/last_ball", draw: @game.draws.order(position: :desc).first %>
        </div>

        <%# Finished games get their own CTA below (see the "Finished (host)"
          branch), so the draw button only ever renders for an active game —
          no need to juggle a finished? case in its disabled/label logic here. %>
        <% if is_host_of?(@game) && @game.active? %>
          <div id="draw-button">
            <%= render "games/draw_button", game: @game %>
          </div>
        <% end %>

        <div class="flex gap-2 items-center min-h-[38px]">
          <span class="font-display text-[11px] uppercase tracking-[0.1em] text-bingo-muted"><%= t("games.show.active.recent_label") %></span>
          <div id="draw-history" class="flex gap-2">
            <%= render "games/draw_history", draws: @game.draws.order(position: :desc).limit(5) %>
          </div>
        </div>
      </div>

      <%# RIGHT: full board + restart %>
      <div class="flex-[1_1_320px] min-w-[280px] flex flex-col gap-3">
        <div class="flex justify-between items-baseline">
          <span class="font-display text-xs uppercase tracking-[0.1em] text-bingo-muted"><%= t("games.show.active.board_label") %></span>
          <div id="drawn-count">
            <%= render "games/drawn_count", game: @game %>
          </div>
        </div>

        <div id="board">
          <%= render "games/board", game: @game %>
        </div>

        <% if is_host_of?(@game) && @game.active? %>
          <%= button_to t("games.show.active.restart_button"), restart_game_path(code: @game.code), method: :post,
              class: "self-start mt-1 #{btn_pill_muted_classes}",
              data: { turbo_confirm: t("games.show.confirm_restart") } %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Finished (non-host) %>
  <% if @game.finished? && !is_host_of?(@game) %>
    <div class="text-center py-4 text-bingo-muted font-body">
      <p class="m-0"><%= t("games.show.finished.message") %></p>
    </div>
  <% end %>

  <%# Finished (host) %>
  <% if @game.finished? && is_host_of?(@game) %>
    <div class="text-center flex flex-col items-center gap-4 py-4">
      <p class="text-bingo-muted font-body m-0"><%= t("games.show.finished.message") %></p>
      <%= link_to t("pages.home.create"), root_path, class: btn_primary_classes %>
    </div>
  <% end %>

  <%# Finish button (host) — always visible while not finished %>
  <% if is_host_of?(@game) && !@game.finished? %>
    <div class="text-center">
      <%= button_to t("games.show.finish_button"), finish_game_path(code: @game.code), method: :post,
          class: "#{btn_ghost_classes} underline underline-offset-2",
          data: { turbo_confirm: t("games.show.confirm_finish") } %>
    </div>
  <% end %>
</div>
