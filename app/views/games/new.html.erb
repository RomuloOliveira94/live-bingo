<% content_for :title, t("games.new.title") %>

<header class="text-center mb-8">
  <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-rose-600">
    <%= t("app.name") %>
  </h1>
  <p class="mt-2 text-slate-500 text-base sm:text-lg">
    <%= t("app.tagline") %>
  </p>
</header>

<div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8">
  <h2 class="text-xl font-semibold text-slate-800 mb-6">
    <%= t("games.new.title") %>
  </h2>

  <%= form_with url: games_path, method: :post, local: true, class: "space-y-5" do |f| %>
    <div>
      <%= f.label :name, t("games.new.name_label"), class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_field :name,
            class: "w-full rounded-lg border border-slate-300 px-4 py-3 text-base text-slate-900 placeholder-slate-400 focus:border-rose-500 focus:ring-2 focus:ring-rose-500 focus:outline-none",
            placeholder: t("games.new.name_placeholder") %>
    </div>

    <div>
      <%= f.label :pattern, t("games.new.pattern_label"), class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.select :pattern, options_for_select([
            [t("patterns.line"), "line"],
            [t("patterns.column"), "column"],
            [t("patterns.diagonal"), "diagonal"],
            [t("patterns.corners"), "corners"],
            [t("patterns.blackout"), "blackout"],
            [t("patterns.x_pattern"), "x_pattern"]
          ], "line"), {},
          class: "w-full rounded-lg border border-slate-300 px-4 py-3 text-base text-slate-900 bg-white focus:border-rose-500 focus:ring-2 focus:ring-rose-500 focus:outline-none" %>
    </div>

    <div>
      <%= f.submit t("games.new.submit"),
            class: "w-full rounded-lg bg-rose-600 hover:bg-rose-700 active:bg-rose-800 text-white text-lg font-semibold py-4 px-6 transition-colors cursor-pointer shadow-sm" %>
    </div>
  <% end %>
</div>
