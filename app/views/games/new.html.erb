<% content_for :title, t("games.new.title") %>

<header class="text-center mb-8">
  <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-bingo-fg">
    <%= t("app.name") %>
  </h1>
  <p class="mt-2 text-bingo-muted text-base sm:text-lg">
    <%= t("app.tagline") %>
  </p>
</header>

<div class="bg-bingo-surface rounded-2xl border border-bingo-line p-6 sm:p-8">
  <h2 class="text-xl font-semibold text-bingo-fg mb-6">
    <%= t("games.new.title") %>
  </h2>

  <%= form_with url: games_path, method: :post, local: true, class: "space-y-5" do |f| %>
    <div>
      <%= f.label :name, t("games.new.name_label"), class: "block text-sm font-medium text-bingo-fg mb-1" %>
      <%= f.text_field :name,
            class: "w-full rounded-lg border border-bingo-line px-4 py-3 text-base text-bingo-fg placeholder-bingo-muted focus:border-bingo-fg focus:ring-2 focus:ring-bingo-fg focus:outline-none",
            placeholder: t("games.new.name_placeholder") %>
    </div>

    <div>
      <%= f.label :pattern, t("games.new.pattern_label"), class: "block text-sm font-medium text-bingo-fg mb-1" %>
      <%= f.select :pattern, options_for_select([
            [t("patterns.line"), "line"],
            [t("patterns.column"), "column"],
            [t("patterns.diagonal"), "diagonal"],
            [t("patterns.corners"), "corners"],
            [t("patterns.blackout"), "blackout"],
            [t("patterns.x_pattern"), "x_pattern"]
          ], "line"), {},
          class: "w-full rounded-lg border border-bingo-line px-4 py-3 text-base text-bingo-fg bg-bingo-bg focus:border-bingo-fg focus:ring-2 focus:ring-bingo-fg focus:outline-none" %>
    </div>

    <div>
      <%= f.submit t("games.new.submit"),
            class: "w-full rounded-lg bg-bingo-red hover:brightness-90 text-bingo-on-red text-lg font-semibold py-4 px-6 cursor-pointer" %>
    </div>
  <% end %>
</div>
