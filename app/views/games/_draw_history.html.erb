<%# Renders horizontal badges with drawn numbers.
  Locals:
    draws - Array/ActiveRecord of Draw instances (most recent first)
%>
<% if draws.any? %>
  <div class="flex flex-wrap gap-2 justify-center max-w-md mx-auto">
    <% draws.each do |draw| %>
      <span class="inline-flex w-10 h-10 items-center justify-center rounded-full bg-slate-100 text-slate-700 font-semibold text-sm">
        <%= draw.number %>
      </span>
    <% end %>
  </div>
<% else %>
  <p class="text-center text-slate-500"><%= t("games.show.active.no_draws_yet") %></p>
<% end %>
