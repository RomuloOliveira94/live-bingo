<%# Renders horizontal badges with drawn numbers.
  Locals:
    draws - Array/ActiveRecord of Draw instances (most recent first)
%>
<% draws.each do |draw| %>
  <span class="inline-flex w-9 h-9 items-center justify-center rounded-full bg-bingo-surface text-bingo-fg text-sm font-semibold">
    <%= draw.number %>
  </span>
<% end %>
