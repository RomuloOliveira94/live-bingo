<%# Cage + ball + ring showing the last drawn number.
  The ring (letter + number) is always in the DOM — not just when `draw` is
  present — so spin_controller.js has a stable element to flicker fake
  numbers into during the suspense animation; it's kept invisible (not
  display:none, so nothing reflows when it's revealed) until the first ball
  is drawn or a spin starts. "Spinning" (fast orbit + shake + pulse ring) is
  toggled by spin_controller.js — see the wrapping element in show.html.erb.
  Locals:
    draw - Draw instance or nil
%>
<div data-spin-target="cage" class="relative w-[230px] h-[230px] rounded-full bg-bingo-cage border-[1.5px] border-bingo-line flex items-center justify-center">
  <div class="bingo-orbit absolute inset-[10px] rounded-full animate-orbit">
    <span class="absolute top-1.5 left-1/2 -translate-x-1/2 w-3.5 h-3.5 rounded-full bg-bingo-accent opacity-[0.35]" aria-hidden="true"></span>
    <span class="absolute bottom-1.5 left-1/2 -translate-x-1/2 w-2.5 h-2.5 rounded-full bg-bingo-fg opacity-[0.14]" aria-hidden="true"></span>
    <span class="absolute left-1.5 top-1/2 -translate-y-1/2 w-2 h-2 rounded-full bg-bingo-accent opacity-[0.22]" aria-hidden="true"></span>
  </div>

  <div class="bingo-ball relative w-[150px] h-[150px] rounded-full flex items-center justify-center animate-ball-pop">
    <div data-spin-target="ring" class="bingo-ring w-[104px] h-[104px] rounded-full flex items-baseline justify-center gap-[5px] <%= "invisible" unless draw %>">
      <span data-spin-target="letter" class="font-display font-bold text-xl leading-none pt-[38px]"><%= draw && bingo_letter(draw.number) %></span>
      <span data-spin-target="number" class="font-display font-bold text-[46px] leading-none tracking-[-0.03em] pt-[32px]"><%= draw&.number %></span>
    </div>
  </div>
</div>
