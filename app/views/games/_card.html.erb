<%# Renders a 5x5 bingo card.
  Locals:
    card       - Card instance (responds to #rows)
    drawn_set  - Set of drawn numbers (Integers)
%>
<div class="max-w-md mx-auto">
  <%# Column headers B I N G O %>
  <div class="grid grid-cols-5 gap-1 sm:gap-2 mb-2">
    <% %w[B I N G O].each do |letter| %>
      <div class="text-center font-extrabold text-rose-600 text-xl"><%= letter %></div>
    <% end %>
  </div>

  <%# Grid %>
  <div class="grid grid-cols-5 gap-1 sm:gap-2">
    <% card.rows.each_with_index do |row, ri| %>
      <% row.each_with_index do |cell, ci| %>
        <% is_free = cell.to_s == "free" %>
        <% marked = is_free || drawn_set.include?(cell.to_i) %>
        <div class="<%= card_cell_classes(cell, drawn_set) %>">
          <%= is_free ? t("games.show.card.free_label") : cell %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
